<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- LEFT COLUMN: Neon Progress & Reset Timer -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="8dp">

        <!-- Overlay container for progress text inside the ring -->
        <RelativeLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ImageView
                android:id="@+id/widget_progress_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_percentage_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOALS"
                    android:textColor="#94A3B8"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="RESET IN"
            android:textColor="#64748B"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_reset_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#06B6D4"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider Line -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#26FFFFFF" />

    <!-- RIGHT COLUMN: Active Task controls or list of remaining tasks -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAILY TRACKER"
            android:textColor="#818CF8"
            android:textSize="8sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 1. ACTIVE TASK CONTROLLER (Visible when a task is running) -->
        <LinearLayout
            android:id="@+id/widget_active_task_dock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_active_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Studying Spring Boot"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_active_task_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Session: 00:00"
                android:textColor="#F59E0B"
                android:textSize="8sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <!-- Play / Pause Action Button -->
                <ImageView
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_widget_pause"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:contentDescription="Pause/Resume Timer" />

                <!-- Stop Action Button -->
                <ImageView
                    android:id="@+id/widget_btn_stop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_widget_stop"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="Stop and discard timer" />

                <!-- Complete Action Button -->
                <ImageView
                    android:id="@+id/widget_btn_complete"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_widget_check"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="Mark completed" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. TASKS LIST (Visible when no task is running) -->
        <LinearLayout
            android:id="@+id/widget_tasks_list_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/widget_empty_tasks_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No tasks for today!"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Row 1 -->
            <LinearLayout
                android:id="@+id/widget_task_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_task_row_1_play"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_play"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/widget_task_row_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Study Spring Boot"
                    android:textColor="#CBD5E1"
                    android:textSize="9.5sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_task_row_1_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.5h"
                    android:textColor="#64748B"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:id="@+id/widget_task_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_task_row_2_play"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_play"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/widget_task_row_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Revise Collections"
                    android:textColor="#CBD5E1"
                    android:textSize="9.5sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_task_row_2_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1h"
                    android:textColor="#64748B"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:id="@+id/widget_task_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_task_row_3_play"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_play"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/widget_task_row_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="React Dashboard"
                    android:textColor="#CBD5E1"
                    android:textSize="9.5sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_task_row_3_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h"
                    android:textColor="#64748B"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
